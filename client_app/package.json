{
  "name": "client_app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-google-maps/api": "^2.1.1",
    "@testing-library/jest-dom": "^5.11.9",
    "@testing-library/react": "^11.2.5",
    "@testing-library/user-event": "^12.8.3",
    "axios": "^0.21.1",
    "ktpm-sgu-doan": "file:..",
    "postcss": "8.4.31",
    "query-string": "^7.0.0",
    "react": "^17.0.1",
    "react-bootstrap": "^1.5.2",
    "react-datepicker": "^4.1.0",
    "react-dom": "^17.0.1",
    "react-hook-form": "^6.15.5",
    "react-infinite-scroll-component": "^6.1.0",
    "react-redux": "^7.2.3",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^4.0.3",
    "react-slick": "^0.28.1",
    "redux": "^4.0.5",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^3.1.0",
    "web-vitals": "^1.1.1"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "dev": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:watch": "react-scripts test --watch",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "test:auth": "react-scripts test Auth.test.js --watchAll=false",
    "test:product": "react-scripts test ProductList.test.js --watchAll=false",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:user-flow": "cypress run --spec 'cypress/e2e/user-flow.cy.js'",
    "cypress:run:product": "cypress run --spec 'cypress/e2e/product-search.cy.js'",
    "cypress:run:all": "cypress run --spec 'cypress/e2e/**/*.cy.js'",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "test:all": "npm run test:ci && npm run cypress:run:all",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
